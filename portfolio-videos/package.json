{
  "name": "portfolio-videos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:inkforge": "remotion render src/index.ts InkForge out/inkforge-preview.mp4",
    "render:spritestudio": "remotion render src/index.ts SpriteStudio out/spritestudio-preview.mp4",
    "render:aistudio": "remotion render src/index.ts AIStudio out/aistudio-preview.mp4",
    "render:all": "npm run render:inkforge && npm run render:spritestudio && npm run render:aistudio"
  },
  "dependencies": {
    "remotion": "4.0.242",
    "@remotion/cli": "4.0.242",
    "@remotion/google-fonts": "4.0.242",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "5.7.3"
  }
}
